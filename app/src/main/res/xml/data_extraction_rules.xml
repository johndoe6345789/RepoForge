<?xml version="1.0" encoding="utf-8"?>
<!-- Accounts aren't copied to new devices: their tokens are bound to this device's Keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
